{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaowe-tech",
  "compatibility_date": "2026-07-26",
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": ".",
    "not_found_response": "404.html",
    "html_handling": "auto-trailing-slash",
    "pretty_urls": true
  }
}
