# 小维健康科技官网 — 阿里云 Nginx 配置模板
#
# 部署形态: 根路径 + www.xiaowe.cc (2026-08-22 拍板, 见 REVIEW_ACTIONS.md P0-1 / DEV_LOG)
# 使用方式:
#   1. 服务器上放证书: /etc/nginx/ssl/xiaowe.cc.pem + .key (阿里云免费证书下载)
#   2. dist 产物上传到: /var/www/xiaowe-tech/
#   3. 本文件复制到 /etc/nginx/sites-available/ 或 conf.d/, 按实际路径调整后 nginx -s reload
#
# 前置提醒:
#   - ICP 备案是硬前置 (.cc 域名解析大陆服务器必须备案)
#   - DNS 在备案完成后从凡科切到阿里云; apex xiaowe.cc 与 www 都解析过来, 由本配置统一 301 到 www

# ---------- HTTP → HTTPS 强跳 ----------
server {
    listen 80;
    listen [::]:80;
    server_name xiaowe.cc www.xiaowe.cc;

    # 备案期间如需保留验证文件可放开下面一段, 其余全部强跳 https
    location /.well-known/ { root /var/www/xiaowe-tech; }

    return 301 https://www.xiaowe.cc$request_uri;
}

# ---------- HTTPS 主站 ----------
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.xiaowe.cc;

    # apex 301 到 www (canonical 统一为 https://www.xiaowe.cc)
    if ($host = "xiaowe.cc") {
        return 301 https://www.xiaowe.cc$request_uri;
    }

    ssl_certificate     /etc/nginx/ssl/xiaowe.cc.pem;
    ssl_certificate_key /etc/nginx/ssl/xiaowe.cc.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # dist 产物目录 (含 186 个预渲染 index.html + assets + public 资源 + 404.html)
    root  /var/www/xiaowe-tech;
    index index.html;

    # 压缩: JS/CSS/JSON/SVG/文本 (webp/png/mp4 已压缩不再 gzip)
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/xml image/svg+xml text/javascript;

    # 安全头
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 关键路由规则:
    #   $uri          → 精确命中静态资源 (assets/*, images/*, videos/*, sitemap.xml, robots.txt ...)
    #   $uri/index.html → 命中预渲染页 (dist/zh-CN/about/index.html 等 186 页) → 返回 200
    #   /index.html   → SPA 兜底 (未预渲染的旧新闻详情等) → 返回 200 由客户端渲染
    # 注意: 不使用 error_page 404 兜底, 保证所有合法 URL 返回 200 而非 404 状态码
    location / {
        try_files $uri $uri/index.html /index.html;
    }

    # 带指纹的构建产物: 缓存 1 年 immutable
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # HTML 入口与预渲染页: no-cache (发布即生效, 配合 sitemap 更新频率)
    location ~* \.html$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # 图片/视频: 公共资源无指纹, 用协商缓存 7 天
    location ~* ^/(images|videos)/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # SEO 固定文件精确缓存策略
    location = /sitemap.xml { add_header Cache-Control "public, max-age=3600"; }
    location = /robots.txt  { add_header Cache-Control "public, max-age=3600"; }

    # 上传体积 (后台如有管理功能需要)
    client_max_body_size 20m;
}
